{
    "compilerOptions": {
        "module": "nodenext",
        "types": [
            "node"
        ],
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        // third-party declaration quirks (vitepress/vue/vite types) —
        // not ours to fix
        "skipLibCheck": true
    },
    "exclude": [
        "node_modules"
    ]
}