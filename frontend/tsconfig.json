// Editor-only typecheck for the SPA (vite transpiles with esbuild; root
// tsconfig is nodenext/node for the CLI and excludes this dir).
{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": true,
        "jsx": "preserve",
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
